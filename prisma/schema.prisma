generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model Product {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  catalogNumber Int?
  category    String
  type        String @default("Perfume")
  description String @default("")
  summary     String @default("")
  notes       Json
  occasion    String @default("")
  longevity   String @default("")
  badges      Json
  active      Boolean @default(true)
  archived    Boolean @default(false)
  featured    Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  variants    ProductVariant[]
  images      ProductImage[]
  reviews     Review[]
  @@index([category, active])
}
model ProductVariant {
  id        String @id @default(cuid())
  productId String
  product   Product @relation(fields:[productId], references:[id], onDelete:Cascade)
  size      Int
  price     Int @default(0)
  mrp       Int @default(0)
  stock     Int @default(0)
  enabled   Boolean @default(true)
  image     String @default("")
  imageSize Int?
  @@unique([productId,size])
}
model ProductImage {
  id        String @id @default(cuid())
  productId String
  product   Product @relation(fields:[productId],references:[id],onDelete:Cascade)
  url       String
  alt       String
  sort      Int @default(0)
}
model Category {
  id      String @id @default(cuid())
  slug    String @unique
  name    String
  image   String @default("")
  active  Boolean @default(true)
  sort    Int @default(0)
}
model Collection {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String @default("")
  filter      Json
  image       String @default("")
  active      Boolean @default(true)
}
model ImageTemplate {
  id       String @id @default(cuid())
  size     Int @unique
  name     String
  base     String @default("")
  width    Int @default(1122)
  height   Int @default(1402)
  config   Json
  ready    Boolean @default(false)
  revision Int @default(1)
  updatedAt DateTime @updatedAt
}
model Setting {
  key   String @id
  value Json
}
model Page {
  slug    String @id
  title   String
  content String
}
model Review {
  id        String @id @default(cuid())
  productId String
  product   Product @relation(fields:[productId],references:[id],onDelete:Cascade)
  author    String
  rating    Int
  text      String
  approved  Boolean @default(false)
  createdAt DateTime @default(now())
}
model GenerationJob {
  id        String @id @default(cuid())
  status    String @default("preview")
  plan      Json
  completed Int @default(0)
  total     Int
  error     String @default("")
  lockedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model LoginAttempt {
  key      String @id
  count    Int @default(0)
  resetAt  DateTime
}
