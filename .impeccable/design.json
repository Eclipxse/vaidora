      "css": ".ds-store{--ink:#282828;--muted:#69635b;--line:#e2dbcf;--soft:#f7f4ef;--gold:#b28c42;--accent-text:#7f5c24;--focus:#552121;--body:Urbanist,Arial,sans-serif;--ease-store:cubic-bezier(.16,1,.3,1);font-family:var(--body);color:var(--ink)}.ds-store :is(button,a,input):focus-visible{outline:2px solid var(--focus);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-store *{transition:none!important;animation:none!important;scroll-behavior:auto!important}}.ds-rail-controls{display:flex;justify-content:flex-end;gap:9px}.ds-rail-arrow{display:grid;place-items:center;min-width:44px;height:44px;border:0;border-radius:50%;background:var(--gold);color:#21180d;cursor:pointer}.ds-rail-arrow:hover{background:#d7b575}.ds-rail-arrow:disabled{opacity:.35;cursor:not-allowed}"
